{
  "name": "personalwebsite",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview --port 4321",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:visual": "playwright test --project=visual",
    "validate:html": "html-validate \"dist/**/*.html\"",
    "links": "node scripts/check-internal-links.mjs",
    "links:external": "node scripts/check-external-links.mjs",
    "lhci": "lhci autorun",
    "test:all": "npm run check && npm run lint && npm run format:check && npm test && npm run build && npm run test:dist && npm run validate:html && npm run links && npm run test:e2e && npm run lhci",
    "test:dist": "WITH_DIST=1 vitest run tests/html"
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.13.0",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.63.0",
    "eslint": "^10.11.0",
    "eslint-plugin-astro": "^3.2.1",
    "html-validate": "^11.16.1",
    "linkinator": "^8.1.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2",
    "zod": "^4.6.5"
  }
}
