---
import type { Project } from "../data/schema";
import { formatRange } from "../lib/dates";
interface Props {
  project: Project;
}
const { project: p } = Astro.props;
---

<article class="lot-row">
  <div class="frame">
    <p class="year">{p.start.slice(0, 4)}</p>
    {p.image && (
      <img
        class="thumb"
        src={p.image.src}
        alt={p.image.alt}
        width={p.image.width}
        height={p.image.height}
        loading="lazy"
        decoding="async"
      />
    )}
    <div class="text">
      <h3 class="name" tabindex="-1">
        {p.name}
      </h3>
      <p class="meta">
        <span class="role">{p.role}</span>
        <span class="range">{formatRange(p.start, p.end)}</span>
      </p>
      <p class="desc">{p.description}</p>
      <p class="stack">{p.stack.join(", ")}</p>
    </div>
    {p.links.length > 0 && (
      <ul class="links">
        {p.links.map((l) => (
          <li>
            <a href={l.url} rel="noopener">
              {l.label}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</article>

<style>
  /* Wide Lotería frame for text projects: marigold year cell, content, links. */
  .lot-row {
    background: var(--paper);
    color: var(--ink);
    border: 4px solid var(--ink);
    border-radius: 6px;
    padding: 8px;
  }
  .frame {
    border: 2px solid var(--ink);
    display: flex;
    align-items: stretch;
  }
  .year {
    flex: 0 0 88px;
    display: grid;
    place-items: center;
    background: var(--marigold);
    border-right: 2px solid var(--ink);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    font-variant-numeric: tabular-nums;
  }
  .thumb {
    flex: 0 0 160px;
    width: 160px;
    height: auto;
    object-fit: cover;
    object-position: top;
    border-right: 2px solid var(--ink);
  }
  .text {
    flex: 1;
    min-width: 0;
    padding: 18px 20px;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 28px;
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    /* Long single-word names (DANNYDOMINGUEZ.DEV) must wrap on narrow phones. */
    overflow-wrap: anywhere;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 14px;
    font-size: 14px;
    font-weight: 500;
    color: var(--graphite);
  }
  .desc {
    font-size: 16px;
    line-height: 1.6;
  }
  .stack {
    font-size: 14px;
    color: var(--graphite);
  }
  .links {
    list-style: none;
    padding: 18px 20px;
    flex-shrink: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    font-size: 15px;
    font-weight: 600;
  }
  .links a {
    color: var(--cobalt);
  }
  .links a:hover {
    color: var(--ink);
    text-decoration-thickness: 2px;
  }
  .lot-row[data-called] {
    outline: 4px solid var(--marigold);
    outline-offset: 4px;
  }
  /* The caller focuses the name; keep that focus visible. */
  .name:focus {
    outline: 3px solid var(--ink);
    outline-offset: 3px;
  }
  @media (prefers-reduced-motion: no-preference) {
    .lot-row[data-called] {
      animation: deal 520ms cubic-bezier(0.2, 0.8, 0.2, 1);
    }
  }
  @keyframes deal {
    from {
      transform: perspective(1200px) rotateX(-75deg);
    }
    to {
      transform: none;
    }
  }
  @media screen and (max-width: 767px) {
    .frame {
      flex-direction: column;
    }
    .year {
      flex-basis: auto;
      place-items: center start;
      padding: 4px 16px;
      border-right: 0;
      border-bottom: 2px solid var(--ink);
      font-size: 24px;
    }
    .thumb {
      flex-basis: auto;
      width: 100%;
      height: 180px;
      border-right: 0;
      border-bottom: 2px solid var(--ink);
    }
    .text {
      padding: 16px;
    }
    .name {
      font-size: 24px;
    }
    .links {
      padding: 0 16px 16px;
      flex-direction: row;
      justify-content: flex-start;
      gap: 20px;
    }
  }
</style>
