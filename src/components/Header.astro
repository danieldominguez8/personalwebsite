---
import { profile } from "../data/profile";
const sections = [
  { id: "experience", label: "Experience" },
  { id: "projects", label: "Projects" },
  { id: "skills", label: "Skills" },
  { id: "about", label: "About" },
];
---

<header class="site-header">
  <div class="container bar">
    <a href="/" class="brand">
      <span class="badge" aria-hidden="true">
        DD
      </span>
      <span>{profile.name}</span>
    </a>
    <nav aria-label="Sections">
      <ul>
        {sections.map((s) => (
          <li class="nav-link">
            <a href={`/#${s.id}`}>{s.label}</a>
          </li>
        ))}
        <li>
          <a class="btn btn-small" href={profile.resume}>
            Resume
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--paper);
    border-bottom: 2px solid var(--ink);
  }
  .bar {
    height: 62px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }
  .badge {
    background: var(--cobalt);
    color: var(--paper);
    border-radius: 4px;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 800;
    letter-spacing: 0.02em;
  }
  ul {
    list-style: none;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 24px;
    font-size: 15px;
    font-weight: 500;
  }
  .nav-link a {
    text-decoration: none;
  }
  .nav-link a:hover {
    text-decoration: underline;
  }
  .btn-small {
    padding: 8px 16px;
  }
  @media screen and (max-width: 767px) {
    .nav-link {
      display: none;
    }
  }
  /* Very narrow phones (e.g. 280px fold cover screens): keep name and Resume on one row. */
  @media screen and (max-width: 359px) {
    .bar {
      gap: 8px;
    }
    .brand {
      gap: 8px;
      font-size: 14px;
    }
    .btn-small {
      padding: 8px 12px;
    }
    .badge {
      width: 28px;
      height: 28px;
      font-size: 15px;
    }
  }
</style>
