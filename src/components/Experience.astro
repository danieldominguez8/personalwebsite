---
import { companies, education } from "../data/experience";
import DateRange from "./DateRange.astro";
---

<section id="experience" class="section experience" aria-labelledby="experience-title">
  <div class="container">
    <h2 id="experience-title" class="section-title">
      Experience
    </h2>
    {companies.map((c) => (
      <div class="company">
        {/* DOM order stays title → date for screen readers; CSS moves the date into the rail. */}
        <div class="entry head">
          <h3 class="org">{c.company}</h3>
          <span class="when">
            <DateRange start={c.start} end={c.end} />
          </span>
        </div>
        {c.roles.map((r) => (
          <div class="entry role">
            <h4>{r.title}</h4>
            <span class="when">
              <DateRange start={r.start} end={r.end} />
            </span>
            <ul>
              {r.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    ))}
    {education.map((e) => (
      <div class="entry head education">
        <h3 class="org">{e.school}</h3>
        <span class="when">
          <DateRange start={e.start} end={e.end} />
        </span>
        <p class="degree">{e.degree}</p>
      </div>
    ))}
  </div>
</section>

<style>
  .experience > .container {
    border-top: 4px solid var(--ink);
    padding-top: 28px;
  }
  .company {
    display: flex;
    flex-direction: column;
    gap: 28px;
  }
  /* Date rail: dates in a left column, content on the right. */
  .entry {
    display: grid;
    grid-template-columns: 200px minmax(0, 1fr);
    grid-template-areas:
      "when title"
      ". body";
    column-gap: 32px;
    row-gap: 10px;
    align-items: baseline;
  }
  .entry > :is(h3, h4) {
    grid-area: title;
  }
  .entry > .when {
    grid-area: when;
  }
  .entry > :is(ul, .degree) {
    grid-area: body;
  }
  .when {
    font-size: 15px;
    font-weight: 500;
    color: var(--graphite);
    font-variant-numeric: tabular-nums;
  }
  .org {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3vw, 36px);
    line-height: 1.05;
  }
  h4 {
    font-size: 18px;
    font-weight: 600;
  }
  ul {
    padding-left: 20px;
    font-size: 17px;
    line-height: 1.65;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  li::marker {
    color: var(--cobalt);
  }
  .education {
    border-top: 2px solid var(--ink);
    padding-top: 24px;
  }
  @media screen and (max-width: 767px) {
    .entry {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        "title"
        "when"
        "body";
      row-gap: 4px;
    }
    .entry > :is(ul, .degree) {
      margin-top: 8px;
    }
    ul {
      font-size: 16px;
      padding-left: 18px;
    }
  }
</style>
