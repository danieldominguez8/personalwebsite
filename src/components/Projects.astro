---
import { projects } from "../data/projects";
import ProjectCard from "./ProjectCard.astro";
import ProjectRow from "./ProjectRow.astro";
const cards = projects.filter((p) => p.layout === "card");
const rows = projects.filter((p) => p.layout === "row");
---

<section id="projects" class="section band" aria-labelledby="projects-title">
  <div class="container">
    <h2 id="projects-title" class="section-title">
      Personal Projects
    </h2>
    <div class="grid">
      {cards.map((p) => (
        <ProjectCard project={p} />
      ))}
    </div>
    <div class="rows">
      {rows.map((p) => (
        <ProjectRow project={p} />
      ))}
    </div>
  </div>
</section>

<style>
  /* The one bold element: a full-width cobalt band of Lotería-style cards. */
  .band {
    background: var(--cobalt);
    color: var(--paper);
  }
  /* Every link in the band sits on a paper card, so the default rosa focus ring
     (5.8:1 on paper) applies; marigold would be 1.8:1 there. */
  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 32px;
  }
  .rows {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  @media (max-width: 767px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 24px;
    }
  }
</style>
