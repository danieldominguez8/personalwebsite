  </section>
</Base>

<style>
  .notfound {
    padding-block: 96px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  h1 {
    font-family: var(--font-display);
    font-weight: 400;
    font-size: 48px;
  }
</style>
